# ==============================================================================
# RIVIOKET E-Commerce — Environment Variables Specification (.env.example)
# Document required environment variables without real secrets.
# DO NOT commit real API keys or production secrets to version control.
# ==============================================================================

# Application Root URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database Connections (Supabase / Managed Postgres)
# DATABASE_URL: Pooled connection string (Transaction mode, e.g. pgbouncer port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct connection string for Prisma migrations (Session mode, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Authentication & Storage Public Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_SUPABASE_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key"

# Supabase Server-Side Service Role Key (NEVER expose to browser/client bundle)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_service_role_key"

# Stripe Payments Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51PlaceholderPublishableKey"
STRIPE_SECRET_KEY="sk_test_51PlaceholderSecretKey"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_webhook_secret"
